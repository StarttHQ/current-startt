{
 "cleanUrls": true,
 "trailingSlash": true,
 "headers": [
  {
   "source": "/data/(.*).md",
   "headers": [
    {
     "key": "Content-Type",
     "value": "text/plain; charset=utf-8"
    },
    {
     "key": "Access-Control-Allow-Origin",
     "value": "*"
    },
    {
     "key": "X-Robots-Tag",
     "value": "noindex"
    },
    {
     "key": "Cache-Control",
     "value": "public, max-age=3600"
    }
   ]
  },
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=600"
    }
   ]
  }
 ]
}